# ── OpenAI ────────────────────────────────────────────────────────────────────
# Powers GPT-4o scam detection (best accuracy) + semantic embedding fallback.
# Without this, detection falls back to local hotword + rule-based methods.
OPENAI_API_KEY=sk-...

# ── Deepgram (optional) ───────────────────────────────────────────────────────
# Cuts real-time monitoring transcription latency from ~5s to ~300ms.
# Get a free key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# ── Plivo (optional) ──────────────────────────────────────────────────────────
# Required to enable phone call integration (/plivo/* routes).
# Find these in your Plivo console: https://console.plivo.com
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=+1234567890   # your Plivo number (E.164 format)
PLIVO_ALERT_NUMBER=+0987654321  # number to SMS when a scam is detected

# ── Flask ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-string
